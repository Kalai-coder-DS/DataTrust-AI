# .env.example  ->  copy to `.env` and fill in your values.
# `.env` is listed in .gitignore, so your password never goes to GitHub.
# NEVER put your real password in this .example file.

DATATRUST_DB=mysql
DATATRUST_MYSQL_HOST=localhost
DATATRUST_MYSQL_PORT=3306
DATATRUST_MYSQL_USER=root
DATATRUST_MYSQL_PASSWORD=change-me
DATATRUST_MYSQL_DATABASE=datatrust

# To use SQLite instead (no server needed), set DATATRUST_DB=sqlite.
# DATATRUST_SQLITE_PATH=data/datatrust.db

# ---------- Phase 9: plain-language summaries (all optional) ----------
# Which provider writes the summary: auto (default) | template | ollama | claude
# DATATRUST_SUMMARY_PROVIDER=auto
# Claude API: set your key here (from console.anthropic.com) to enable it. Never commit .env.
# ANTHROPIC_API_KEY=
# DATATRUST_CLAUDE_MODEL=claude-haiku-5-5
# Local AI with Ollama (https://ollama.com): free, runs on your computer.
# DATATRUST_OLLAMA_URL=http://localhost:11434
# DATATRUST_OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for an AI answer (a laptop without a GPU can take 30-90 s).
# DATATRUST_AI_TIMEOUT=120

# ---------- Phase 10: web app login ----------
# Every page asks for this password. Leave empty for no login (only on your own computer).
# Required when DATATRUST_DEBUG=0, together with DATATRUST_SECRET_KEY.
# DATATRUST_WEB_PASSWORD=
# Run analyses in the background (1, default) or inside the request (0); how many at once.
# DATATRUST_WEB_BACKGROUND=1
# DATATRUST_WEB_WORKERS=2

# ---------- Deployment (public demo on Render) ----------
# You don't need these on your computer. render.yaml sets them on Render, where the secret key is
# generated by Render itself. Details: docs/DEPLOYMENT.md
# DATATRUST_DEBUG=0
# DATATRUST_PUBLIC_DEMO=1              # open demo: no login, private uploads per browser, limits below
# DATATRUST_HTTPS=1                    # production: HTTPS redirect, HSTS, secure cookies
# DATATRUST_DEMO_MAX_ROWS=20000
# DATATRUST_DEMO_MAX_COLUMNS=50
# DATATRUST_DEMO_UPLOADS_PER_HOUR=10
# DATATRUST_DEMO_UPLOADS_PER_HOUR_TOTAL=60
# DATATRUST_DEMO_MAX_PENDING=3
# DATATRUST_DEMO_RETENTION_HOURS=24
# DATATRUST_DEMO_MAX_STORED_RUNS=300
# DATATRUST_ML_CV_REPEATS=3            # the demo uses 1 (slow CPU)
# DATATRUST_ML_IMPORTANCE_REPEATS=5    # the demo uses 2
